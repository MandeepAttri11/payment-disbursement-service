{
  "title": "Payment Disbursement Service",
  "uid": "payment-disbursement",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Disbursements created (per sec)",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 6},
      "targets": [{"expr": "sum(rate(disbursement_created_total[5m]))", "refId": "A"}]
    },
    {
      "id": 2,
      "title": "Attempts by channel & outcome (per sec)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 6},
      "targets": [{"expr": "sum by (channel, outcome) (rate(disbursement_attempt_seconds_count[5m]))", "refId": "A"}]
    },
    {
      "id": 3,
      "title": "p99 attempt latency per channel",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 6, "w": 12, "h": 6},
      "targets": [{"expr": "histogram_quantile(0.99, sum by (le, channel) (rate(disbursement_attempt_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "id": 4,
      "title": "Disbursement outcome ratio",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 6, "w": 12, "h": 6},
      "targets": [{"expr": "sum by (outcome) (rate(disbursement_completed_total[5m]))", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "Reconciliation breaks per hour",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "targets": [{"expr": "sum by (type) (rate(reconcile_breaks_total[1h]))", "refId": "A"}]
    },
    {
      "id": 6,
      "title": "Circuit breaker state per channel",
      "type": "stat",
      "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "targets": [{"expr": "resilience4j_circuitbreaker_state", "refId": "A"}]
    }
  ]
}
